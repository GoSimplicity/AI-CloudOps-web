{
  "name": "vben-admin-pro",
  "version": "5.2.2",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "vben",
    "vben admin",
    "vben pro",
    "vue",
    "vue admin",
    "vue vben admin",
    "vue vben admin pro",
    "vue3"
  ],
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": "vbenjs/vue-vben-admin.git",
  "license": "MIT",
  "author": {
    "name": "vben",
    "email": "ann.vben@gmail.com",
    "url": "https://github.com/anncwb"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docker": "./build-local-docker-image.sh",
    "build:antd": "pnpm run build --filter=@vben/web-antd",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "vsh clean",
    "commit": "czg",
    "dev": "pnpm run dev:antd",
    "dev:antd": "pnpm -F @vben/web-antd run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "turbo run stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || husky",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm bootstrap",
    "test:demo": "node --test scripts/demo/*.check.mjs",
    "test:unit": "vitest",
    "update:deps": "pnpm update --latest --recursive",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile",
    "test:e2e": "playwright test",
    "check:layout": "node scripts/layout-inventory.mjs --check",
    "update:layout": "node scripts/layout-inventory.mjs",
    "check:eslint-boundaries": "node scripts/check-eslint-boundaries.mjs"
  },
  "dependencies": {
    "jiti": "^2.3.3",
    "vue-request": "^2.0.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.8",
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.4",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/prettier-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "cspell": "^8.14.2",
    "husky": "^9.1.5",
    "is-ci": "^3.0.1",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.10",
    "rimraf": "^6.0.1",
    "stylelint": "^16.9.0",
    "tailwindcss": "^3.4.10",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "unbuild": "^2.0.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.3",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.9.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {
      "@babel/plugin-transform-modules-systemjs@7": "7.29.8",
      "@ctrl/tinycolor": "4.1.0",
      "@intlify/core": "11.4.18",
      "@intlify/core-base": "11.4.18",
      "@intlify/shared": "11.4.18",
      "@intlify/vue-i18n-core": "11.4.18",
      "@isaacs/brace-expansion": "5.0.1",
      "axios": "^1.21.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.29.5",
      "clsx": "2.1.1",
      "defu@6": "6.1.7",
      "dompurify": "^3.4.16",
      "fast-uri@3": "3.1.9",
      "flatted@3": "3.4.4",
      "follow-redirects@1": "1.16.3",
      "h3@1": "1.15.11",
      "immutable@5": "5.1.10",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "minimatch@10": "10.2.6",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@7": "7.4.9",
      "minimatch@9": "9.0.9",
      "nanoid@3": "3.3.20",
      "nanoid@5": "5.1.16",
      "node-forge@1": "1.4.3",
      "petite-vue-i18n": "11.4.18",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.7",
      "pinia": "2.2.2",
      "postcss@8": "8.5.32",
      "rollup@0.25.8": "2.80.0",
      "rollup@4": "4.68.2",
      "serialize-javascript@6": "7.1.4",
      "source-map-js@1": "1.2.2",
      "svgo@4": "4.1.0",
      "tar@^7": "^7.5.12",
      "tinypool": "2.1.2",
      "undici@6": "6.29.1",
      "vue": "3.5.42",
      "vue-i18n": "11.4.18"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp",
      "playwright"
    ]
  }
}
